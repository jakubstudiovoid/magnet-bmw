---
import "../styles/global.css";
import { site } from "../data";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: unknown;
}
const { title, description, canonical = Astro.url.pathname, jsonLd } = Astro.props;
const year = new Date().getFullYear();
const path = canonical.startsWith("http") ? canonical : new URL(canonical, site.url).href;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="canonical" href={path} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={path} />
    <meta property="og:image" content={`${site.url}/images/about.webp`} />
    <meta property="og:locale" content="cs_CZ" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/images/about.webp`} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#obsah">Přeskočit na obsah</a>
    <header id="nav" class="fixed inset-x-0 top-0 z-50 transition-colors duration-500">
      <div class="shell flex h-16 items-center justify-between">
        <a href="/#uvod" class="nav-link text-paper" aria-label="MAGNET BMW, úvod">
          <span class="wordmark text-lg">
            <span class="wordmark-dot" aria-hidden="true"></span>
            MAGNET
            <span class="wordmark-bmw">BMW</span>
          </span>
        </a>
        <nav class="hidden items-center gap-8 md:flex" aria-label="Hlavní">
          <a href="/#o-nas" class="nav-link text-sm tracking-wide text-paper/80">O nás</a>
          <a href="/#sluzby" class="nav-link text-sm tracking-wide text-paper/80">Služby</a>
          <a href="/#kontakt" class="nav-link text-sm tracking-wide text-paper/80">Kontakt</a>
          <a href={site.phoneHref} class="btn btn-fill" data-magnetic>Zavolat</a>
        </nav>
        <button type="button" class="btn btn-ghost md:hidden" id="menu-btn" aria-expanded="false" aria-controls="menu-mobil">
          Menu
        </button>
      </div>
      <div id="menu-mobil" class="fixed inset-0 top-16 z-40 hidden flex-col bg-ink px-6 pt-10 md:hidden" hidden>
        <nav class="flex flex-col gap-6" aria-label="Mobilní">
          <a href="/#o-nas" class="headline text-paper" data-close>O nás</a>
          <a href="/#sluzby" class="headline text-paper" data-close>Služby</a>
          <a href="/#kontakt" class="headline text-paper" data-close>Kontakt</a>
        </nav>
        <a href={site.phoneHref} class="btn btn-fill mt-10 w-fit">Zavolat</a>
      </div>
    </header>
    <div id="obsah">
      <slot />
    </div>
    <footer class="border-t border-line bg-ink pb-24 md:pb-0">
      <div class="shell flex flex-col gap-10 py-12 md:flex-row md:items-end md:justify-between">
        <div>
          <span class="wordmark text-lg">
            <span class="wordmark-dot" aria-hidden="true"></span>
            MAGNET
            <span class="wordmark-bmw">BMW</span>
          </span>
          <p class="mt-4 max-w-xs text-sm text-paper/60">{site.claim}. Autoservis v Jablonci nad Nisou.</p>
        </div>
        <address class="text-sm leading-relaxed text-paper/70 not-italic">
          {site.street}, {site.city}<br />
          <a class="nav-link" href={site.phoneHref}>{site.phoneDisplay}</a><br />
          <a class="nav-link" href={site.emailHref}>{site.email}</a>
        </address>
        <div class="text-sm text-paper/60">
          <a class="nav-link" href="/ochrana-osobnich-udaju">Zásady ochrany osobních údajů</a>
          <p class="mt-3">© {year} MAGNET BMW</p>
        </div>
      </div>
    </footer>
    <a class="call-dock" href={site.phoneHref}>Zavolat</a>
    <script>
      import Lenis from "lenis";

      const root = document.documentElement;
      root.classList.add("js");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const nav = document.getElementById("nav");
      const onScroll = () => {
        const on = window.scrollY > 12;
        nav?.classList.toggle("bg-ink/75", on);
        nav?.classList.toggle("backdrop-blur-md", on);
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      const menu = document.getElementById("menu-mobil");
      const btn = document.getElementById("menu-btn");
      const setMenu = (open: boolean) => {
        if (!menu || !btn) return;
        menu.hidden = !open;
        menu.classList.toggle("hidden", !open);
        menu.classList.toggle("flex", open);
        btn.setAttribute("aria-expanded", String(open));
        btn.textContent = open ? "Zavřít" : "Menu";
        document.body.classList.toggle("menu-open", open);
      };
      btn?.addEventListener("click", () => setMenu(btn.getAttribute("aria-expanded") !== "true"));
      menu?.querySelectorAll("[data-close]").forEach((link) => link.addEventListener("click", () => setMenu(false)));
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setMenu(false);
      });

      const mapBtn = document.getElementById("map-btn");
      mapBtn?.addEventListener("click", () => {
        const slot = document.getElementById("map-slot");
        if (!slot) return;
        slot.innerHTML =
          '<iframe title="Mapa MAGNET BMW, Jungmannova 8, Jablonec nad Nisou" src="https://www.openstreetmap.org/export/embed.html?bbox=15.1668%2C50.7218%2C15.1798%2C50.7271&layer=mapnik&marker=50.7244325%2C15.1733150" class="aspect-video w-full border-0 grayscale" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>';
      });

      if (!reduce) {
      const lenis = new Lenis({ lerp: 0.085, smoothWheel: true, autoRaf: false });
      const loop = (time: number) => {
        lenis.raf(time);
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
      const photo = document.querySelector<HTMLElement>("[data-parallax]");
      lenis.on("scroll", () => {
        if (photo) photo.style.transform = `translate3d(0, ${lenis.scroll * 0.18}px, 0) scale(1.08)`;
      });
      document.addEventListener("click", (event) => {
        const link = (event.target as HTMLElement | null)?.closest("a[href*='#']");
        if (!link) return;
        const href = link.getAttribute("href") || "";
        const id = href.includes("#") ? href.slice(href.indexOf("#")) : "";
        if (!id || id === "#") return;
        const target = document.querySelector<HTMLElement>(id);
        if (!target || location.pathname !== "/" && !href.startsWith("/#") && !href.startsWith("#")) return;
        if (location.pathname !== "/" && href.startsWith("/#")) return;
        event.preventDefault();
        lenis.scrollTo(target, { offset: -72 });
      });

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-in");
            io.unobserve(entry.target);
          }
        },
        { threshold: 0.16, rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll(".reveal, .wipe").forEach((node) => io.observe(node));

      document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((el) => {
        el.addEventListener("pointermove", (event) => {
          const box = el.getBoundingClientRect();
          const x = (event.clientX - (box.left + box.width / 2)) * 0.28;
          const y = (event.clientY - (box.top + box.height / 2)) * 0.4;
          el.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        });
        el.addEventListener("pointerleave", () => {
          el.style.transform = "";
        });
      });
      }
    </script>
  </body>
</html>

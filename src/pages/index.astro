---
import Base from "../layouts/Base.astro";
import { jsonLd, site } from "../data";

const services = [
  ["Originální diagnostika BMW", "Diagnostika vozu tak, jak k ní patří originální výbava BMW."],
  ["Generální opravy motoru", "Náročnější opravy motoru, když běžná údržba nestačí."],
  ["Opravy podvozku", "Podvozek jako součást komplexní péče o vůz."],
  ["Výměna oleje a filtrů", "Pravidelná údržba, na které stojí spolehlivý provoz."],
  ["Ruční mytí", "Ruční mytí karoserie, pečlivě a bez zbytečného spěchu."],
  ["Čištění interiéru", "Péče o interiér, aby byl vůz příjemný na každou cestu."],
  ["Leštění karoserie", "Leštění laku jako součást péče o karoserii."],
  ["Výměna pneu", "Výměna pneumatik v rámci běžné péče o vůz."],
];
const description =
  "Autoservis MAGNET BMW, Jungmannova 8, Jablonec nad Nisou. Komplexní servis a údržba vozů BMW: diagnostika, motory, podvozek, olej, mytí, interiér, leštění a pneu. Z lásky k automobilům.";
---

<Base title="MAGNET BMW — servis BMW Jablonec nad Nisou" description={description} canonical="/" jsonLd={jsonLd}>
  <main>
    <section id="uvod" class="relative flex min-h-dvh items-end overflow-hidden">
      <div class="absolute inset-0" aria-hidden="true">
        <img
          src="/images/headlight.webp"
          srcset="/images/headlight-800.webp 800w, /images/headlight.webp 1024w"
          sizes="100vw"
          width="1024"
          height="1024"
          alt=""
          class="hero-photo absolute inset-0 h-[120%] w-full object-cover object-[70%_center]"
          data-parallax
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-linear-to-t from-ink via-ink/35 to-transparent"></div>
        <div class="absolute inset-0 bg-linear-to-r from-ink/75 via-transparent to-transparent"></div>
      </div>
      <div class="shell relative z-10 pt-32 pb-20 md:pb-24">
        <p class="fade-up kicker" style="animation-delay:0.15s">Autoservis · {site.city}</p>
        <h1 class="display mt-6">
          <span class="mask"><span class="mask-in" style="animation-delay:0.22s">MAGNET</span></span>
          <span class="mask"><span class="mask-in" style="animation-delay:0.36s">BMW</span></span>
        </h1>
        <p class="fade-up mt-6 max-w-xl text-lg text-paper/80 md:text-2xl" style="animation-delay:0.55s">{site.claim}</p>
        <div class="fade-up mt-10 flex flex-col gap-3 sm:flex-row" style="animation-delay:0.7s">
          <a href={site.phoneHref} class="btn btn-fill" data-magnetic>Objednat servis</a>
          <a href="#sluzby" class="btn btn-ghost" data-magnetic>Služby</a>
        </div>
      </div>
    </section>

    <section id="o-nas" class="scroll-mt-24 bg-paper text-ink">
      <div class="shell grid items-center gap-12 py-24 md:grid-cols-12 md:gap-16 md:py-36">
        <div class="md:col-span-5">
          <p class="reveal kicker text-ink/50">O nás</p>
          <h2 class="reveal headline mt-5">Servis, který vozu rozumí</h2>
          <div class="mt-8 space-y-5 text-base leading-relaxed text-ink/70 md:text-lg">
            <p class="reveal">Specializujeme se na komplexní servis a údržbu vozů BMW. S dlouholetými zkušenostmi nabízíme pravidelnou údržbu i náročnější opravy a vždy dbáme na nejvyšší standardy kvality a bezpečnosti.</p>
            <p class="reveal">Pokud hledáte servis, který rozumí vašemu vozu, navštivte nás v Jablonci nad Nisou. Váš automobil bude v těch nejlepších rukou.</p>
          </div>
        </div>
        <figure class="wipe md:col-span-7">
          <img src="/images/about.webp" srcset="/images/about-800.webp 800w, /images/about.webp 1800w" sizes="(min-width: 768px) 55vw, 100vw" width="1800" height="1013" alt="Průčelí autoservisu MAGNET BMW na Jungmannově ulici v Jablonci nad Nisou" class="aspect-4/3 w-full object-cover md:aspect-5/4" loading="lazy" />
          <figcaption class="mt-3 text-xs tracking-widest text-ink/50 uppercase">Jungmannova 8 · Jablonec nad Nisou</figcaption>
        </figure>
      </div>
    </section>

    <section id="sluzby" class="scroll-mt-24 border-t border-line bg-ink">
      <div class="shell py-24 md:py-36">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div>
            <p class="reveal kicker">Naše služby</p>
            <h2 class="reveal headline mt-5 max-w-xl">Co poskytujeme</h2>
          </div>
          <p class="reveal max-w-sm text-paper/70">Od originální diagnostiky po péči o karoserii. A další práce, které k servisu BMW patří.</p>
        </div>
        <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {services.map(([title, text], index) => (
            <li class="reveal">
              <article class="service h-full">
                <span class="service-icon text-sm tracking-[0.18em]">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3 class="text-lg leading-snug font-semibold tracking-tight">{title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-paper/65">{text}</p>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bg-paper text-ink" aria-labelledby="proc-my-nadpis">
      <div class="shell py-24 md:py-36">
        <p class="reveal kicker text-ink/50">Proč my</p>
        <h2 id="proc-my-nadpis" class="reveal headline mt-5 max-w-3xl">Vůz v těch nejlepších rukou</h2>
        <ol class="mt-16 grid gap-12 md:grid-cols-3">
          <li class="reveal border-t border-ink/15 pt-6">
            <p class="text-sm tracking-[0.18em] text-accent">01</p>
            <h3 class="mt-5 text-2xl font-semibold tracking-tight">Specializace na BMW</h3>
            <p class="mt-3 max-w-sm leading-relaxed text-ink/70">Komplexní servis a údržba vozů BMW. Dílna, která vašemu vozu rozumí.</p>
          </li>
          <li class="reveal border-t border-ink/15 pt-6">
            <p class="text-sm tracking-[0.18em] text-accent">02</p>
            <h3 class="mt-5 text-2xl font-semibold tracking-tight">Dlouholeté zkušenosti</h3>
            <p class="mt-3 max-w-sm leading-relaxed text-ink/70">S dlouholetými zkušenostmi v oboru bereme pravidelnou údržbu i náročnější opravy.</p>
          </li>
          <li class="reveal border-t border-ink/15 pt-6">
            <p class="text-sm tracking-[0.18em] text-accent">03</p>
            <h3 class="mt-5 text-2xl font-semibold tracking-tight">Kvalita a bezpečnost</h3>
            <p class="mt-3 max-w-sm leading-relaxed text-ink/70">Nejvyšší standardy kvality a bezpečnosti. Vůz v těch nejlepších rukou.</p>
          </li>
        </ol>
      </div>
      <figure class="wipe">
        <img src="/images/workshop.webp" srcset="/images/workshop-800.webp 800w, /images/workshop.webp 1080w" sizes="100vw" width="1080" height="863" alt="Vůz BMW na zvedáku v servisní hale" class="max-h-[70vh] w-full object-cover" loading="lazy" />
      </figure>
    </section>

    <section id="kontakt" class="scroll-mt-24 border-t border-line bg-ink">
      <div class="shell grid gap-16 py-24 md:py-36 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="reveal kicker">Kontakt</p>
          <h2 class="reveal headline mt-5">Jsme v Jablonci</h2>
          <a href={site.phoneHref} class="reveal nav-link mt-10 block w-fit text-4xl font-semibold tracking-tight text-paper md:text-5xl">{site.phoneDisplay}</a>
          <a href={site.emailHref} class="reveal nav-link mt-4 block w-fit text-lg text-paper/80">{site.email}</a>
          <div class="reveal mt-10">
            <p class="kicker">Adresa</p>
            <p class="mt-3 text-lg">{site.street}<br />{site.city}</p>
            <p class="mt-2 max-w-sm text-paper/65">{site.addressNote}</p>
          </div>
          <div class="reveal mt-10">
            <p class="kicker">Provozní doba</p>
            <dl class="mt-3 max-w-sm space-y-2">
              <div class="flex justify-between gap-6 text-paper/80"><dt>Pondělí – pátek</dt><dd class="text-paper">9:00 – 17:00</dd></div>
              <div class="flex justify-between gap-6 text-paper/80"><dt>Sobota</dt><dd class="text-paper">Dle telefonické domluvy</dd></div>
            </dl>
          </div>
          <div class="reveal mt-10 flex flex-col gap-3 sm:flex-row">
            <a href={site.phoneHref} class="btn btn-fill" data-magnetic>Objednat servis</a>
            <a href={site.mapsUrl} class="btn btn-ghost" target="_blank" rel="noreferrer">Navigovat</a>
          </div>
        </div>
        <div class="lg:col-span-7">
          <figure class="wipe">
            <img src="/images/entrance.webp" srcset="/images/entrance-800.webp 800w, /images/entrance.webp 1800w" sizes="(min-width: 1024px) 50vw, 100vw" width="1800" height="1012" alt="Vjezd do autoservisu MAGNET BMW z ulice Smetanova, označený modrou šipkou" class="aspect-video w-full object-cover" loading="lazy" />
            <figcaption class="mt-3 text-xs tracking-widest text-mist uppercase">Vjezd ze Smetanovy ulice</figcaption>
          </figure>
          <div class="reveal mt-6 border border-line">
            <div id="map-slot" class="relative">
              <img src="/images/map.webp" srcset="/images/map-800.webp 800w, /images/map.webp 1220w" sizes="(min-width: 1024px) 50vw, 100vw" width="1220" height="686" alt="Schéma příjezdu k autoservisu MAGNET BMW mezi ulicemi Smetanova a Jungmannova" class="aspect-video w-full object-cover" loading="lazy" />
              <div class="absolute inset-0 flex items-start p-4 md:p-6">
                <button type="button" id="map-btn" class="btn btn-fill">Zobrazit mapu</button>
              </div>
            </div>
          </div>
          <p class="mt-3 text-xs leading-relaxed text-paper/50">Interaktivní mapa se načte z OpenStreetMap až po kliknutí. Do té doby web neukládá cookies.</p>
        </div>
      </div>
    </section>
  </main>
</Base>

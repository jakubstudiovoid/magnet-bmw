---
import Base from "../layouts/Base.astro";
import { site } from "../data";
---

<Base title="Stránka nenalezena — MAGNET BMW" description="Tahle adresa na webu MAGNET BMW neexistuje." canonical="/404">
  <main class="shell flex min-h-dvh flex-col justify-end pt-32 pb-24">
    <p class="kicker">404</p>
    <h1 class="display mt-5">Tahle<br />stránka tu není</h1>
    <p class="mt-6 max-w-md text-paper/70">Adresa nevede na žádnou část webu MAGNET BMW. Vraťte se na úvod, nebo rovnou zavolejte.</p>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn btn-fill">Na úvod</a>
      <a href={site.phoneHref} class="btn btn-ghost">Zavolat</a>
    </div>
  </main>
</Base>
